{
    "version": 6,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
            }
        },
        {
            "name": "windows",
            "displayName": "Visual Studio 2022 x64",
            "inherits": "base",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64"
        },
        {
            "name": "linux",
            "displayName": "Linux, Release",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-debug",
            "displayName": "Linux, Debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "macos",
            "displayName": "macOS, Release",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        { "name": "windows", "configurePreset": "windows", "configuration": "Release" },
        { "name": "linux", "configurePreset": "linux" },
        { "name": "linux-debug", "configurePreset": "linux-debug" },
        { "name": "macos", "configurePreset": "macos" }
    ],
    "testPresets": [
        { "name": "windows", "configurePreset": "windows", "configuration": "Release" },
        { "name": "linux", "configurePreset": "linux" },
        { "name": "macos", "configurePreset": "macos" }
    ]
}
